/*
 * Libadwaita (GNOME 50, dark, slate accent) look for rofi.
 * Colors follow libadwaita's dark stylesheet.
 */
* {
    accent:      #6f8396;
    window-bg:   #222226;
    view-bg:     #1d1d20;
    popover-bg:  #36363a;
    fg:          #ffffff;
    fg-dim:      #ffffffa0;
    hover-bg:    #ffffff12;
    selected-bg: #ffffff1a;
    border-col:  #ffffff17;

    font:             "Adwaita Sans 11";
    background-color: transparent;
    text-color:       @fg;
    margin:  0;
    padding: 0;
    spacing: 0;
}

window {
    location:         center;
    width:            560px;
    background-color: @popover-bg;
    border:           1px;
    border-color:     @border-col;
    border-radius:    15px;
    padding:          6px;
}

mainbox {
    children: [ inputbar, message, listview ];
    spacing:  6px;
}

inputbar {
    children:         [ icon-search, entry ];
    background-color: @hover-bg;
    border-radius:    9px;
    padding:          9px 12px;
    spacing:          9px;
    margin:           6px 6px 0 6px;
}

icon-search {
    expand:      false;
    filename:    "system-search-symbolic";
    size:        16px;
    vertical-align: 0.5;
}

entry {
    placeholder:       "Search";
    placeholder-color: @fg-dim;
    cursor-color:      @accent;
    vertical-align:    0.5;
}

message {
    padding: 6px 12px;
}

textbox {
    text-color: @fg-dim;
}

listview {
    lines:        8;
    columns:      1;
    fixed-height: false;
    scrollbar:    false;
    spacing:      2px;
    padding:      0 0 0 0;
}

element {
    padding:       8px 10px;
    spacing:       12px;
    border-radius: 9px;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
}

element selected.normal,
element selected.active {
    background-color: @selected-bg;
}

element normal.active,
element alternate.active {
    text-color: @accent;
}

element normal.urgent,
element alternate.urgent,
element selected.urgent {
    text-color: #ff7b63;
}

element-icon {
    size:           32px;
    vertical-align: 0.5;
}

element-text {
    vertical-align:   0.5;
    highlight:        bold;
    text-color:       inherit;
}
